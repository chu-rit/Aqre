{
  "expo": {
    "name": "AQRE:FILL&FLOW",
    "slug": "aqreRN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.churit.aqre",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.churit.aqre"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4086309578344734~1481007128",
          "iosAppId": "ca-app-pub-4086309578344734~9540713554"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "991cbfe2-bd11-47a0-ae22-650a95a55d40"
      }
    },
    "owner": "churit"
  }
}
